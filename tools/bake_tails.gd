extends Node
## Measures where the tail of every car body is, at the place its name goes, and writes scripts/tail_frames.gd:
##   godot --headless --path . tools/bake_tails.tscn
## The name is lettered flat, so it has to be told how the panel it sits on is placed: how far from the origin of the body
## (z), how it leans (slope: the change of z over a metre of height) and how it curves from side to side (bow: z changes with
## the square of the distance from the middle). They are read off the body's own triangles. Run it again whenever a body
## mesh changes (tools/lettering_test.tscn fails if the file no longer fits the meshes).

const OUT := "res://scripts/tail_frames.gd"
const SPAN := 0.03   # m above and below the name, for the lean
const SIDE := 0.3    # m to the side, for the curve


## The height at which the line (x, y) along z first meets the body from behind (the largest z), by testing every triangle.
static func tail_z(kit: Dictionary, x: float, y: float) -> float:
	var body: ArrayMesh = kit.body
	var names: Array = kit.surfaces
	var best := -99.0
	for si in body.get_surface_count():
		if names[si] == "plate":
			continue
		var arr := body.surface_get_arrays(si)
		var v: PackedVector3Array = arr[Mesh.ARRAY_VERTEX]
		var idx: PackedInt32Array = arr[Mesh.ARRAY_INDEX]
		for t in range(0, idx.size(), 3):
			var a := v[idx[t]]
			var b := v[idx[t + 1]]
			var c := v[idx[t + 2]]
			if maxf(a.x, maxf(b.x, c.x)) < x or minf(a.x, minf(b.x, c.x)) > x or maxf(a.y, maxf(b.y, c.y)) < y or minf(a.y, minf(b.y, c.y)) > y:
				continue
			var d := (b.y - c.y) * (a.x - c.x) + (c.x - b.x) * (a.y - c.y)
			if absf(d) < 1.0e-9:
				continue
			var l1 := ((b.y - c.y) * (x - c.x) + (c.x - b.x) * (y - c.y)) / d
			var l2 := ((c.y - a.y) * (x - c.x) + (a.x - c.x) * (y - c.y)) / d
			var l3 := 1.0 - l1 - l2
			if l1 < 0.0 or l2 < 0.0 or l3 < 0.0:
				continue
			best = maxf(best, l1 * a.z + l2 * b.z + l3 * c.z)
	return best


## {"y", "z", "slope", "bow"} of the tail of body `id` where its name goes.
static func measure(id: String) -> Dictionary:
	var kit: Dictionary = CarModel._kit(id)
	var y := CarModel.badge_y(id)
	var z0 := tail_z(kit, 0.0, y)
	var zl := tail_z(kit, -SIDE, y)
	var zr := tail_z(kit, SIDE, y)
	var zt := tail_z(kit, 0.0, y + SPAN)
	var zb := tail_z(kit, 0.0, y - SPAN)
	return {"y": y, "z": z0, "slope": (zt - zb) / (2.0 * SPAN), "bow": ((zl + zr) * 0.5 - z0) / (SIDE * SIDE), "reach": maxf(absf(zl - z0), absf(zr - z0))}


func _ready() -> void:
	var ids: Array = []
	for k in CarModel.PROFILES:
		if (CarModel.PROFILES[k] as Dictionary).has("mesh") and k != "truck":
			ids.append(k)
	ids.sort()
	var lines: Array = []
	for id in ids:
		var m: Dictionary = measure(id)
		var sane: bool = m.z > -0.4 and m.z < 0.4 and absf(m.slope) < 1.5 and absf(m.bow) < 1.0
		print("%-12s y %.3f  z %+.4f  slope %+.3f  bow %+.3f%s" % [id, m.y, m.z, m.slope, m.bow, "" if sane else "   <-- not on the tail?"])
		if not sane:
			continue
		lines.append("\t\"%s\": {\"y\": %.3f, \"z\": %.4f, \"slope\": %.4f, \"bow\": %.4f}," % [id, m.y, m.z, m.slope, m.bow])
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	f.store_string("class_name TailFrames\nextends RefCounted\n")
	f.store_string("## GENERATED by tools/bake_tails.gd (run it again after a body mesh changes): where the tail of each body is at the place\n")
	f.store_string("## its name goes. y: the height of the name, m. z: where the panel is there (m behind the origin of the body: the lettering\n")
	f.store_string("## is placed on it). slope: how the panel leans (z over y). bow: how it curves away from the middle (z over x squared).\n\n")
	f.store_string("const FRAMES := {\n")
	f.store_string("\n".join(PackedStringArray(lines)))
	f.store_string("\n}\n\n\n## The frame of a body's tail (a flat one at the usual height if the body has none).\n")
	f.store_string("static func of(shape_id: String) -> Dictionary:\n\treturn FRAMES.get(shape_id, {\"y\": 0.74, \"z\": 0.0, \"slope\": 0.0, \"bow\": 0.0})\n")
	f.close()
	print("wrote %d frames to %s" % [lines.size(), OUT])
	get_tree().quit()
